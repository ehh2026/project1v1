<Window x:Class="InteractiveWorldMap.Views.ContentSubwindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Location Content" 
        SizeToContent="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    <Border x:Name="ContentBorder"
            Background="#A61E1E1E"
            CornerRadius="12"
            Padding="15"
            BorderThickness="2"
            BorderBrush="#FFFFFFFF">
        <Border.Effect>
            <DropShadowEffect Color="Black" 
                            Direction="270" 
                            ShadowDepth="6" 
                            BlurRadius="20" 
                            Opacity="0.25"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Title Bar -->
            <TextBlock x:Name="TitleText"
                      Grid.Row="0"
                      FontSize="18"
                      FontWeight="SemiBold"
                      Foreground="#FFFFFFFF"
                      Margin="0,0,0,12"
                      TextWrapping="Wrap"/>
            
            <!-- Content Area with proper sizing -->
            <Viewbox Grid.Row="1"
                    Stretch="Uniform">
                <ContentPresenter x:Name="ContentArea"/>
            </Viewbox>
        </Grid>
    </Border>
</Window>
