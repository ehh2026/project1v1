<Window x:Class="InteractiveWorldMap.Views.ContentSubwindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Location Content" 
        SizeToContent="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    <Border x:Name="ContentBorder"
            Background="#A61E1E1E"
            CornerRadius="12"
            Padding="15"
            BorderThickness="2"
            BorderBrush="#FFFFFFFF">
        <Border.Effect>
            <DropShadowEffect Color="Black" 
                            Direction="270" 
                            ShadowDepth="6" 
                            BlurRadius="20" 
                            Opacity="0.25"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Title Bar -->
            <TextBlock x:Name="TitleText"
                      Grid.Row="0"
                      FontSize="18"
                      FontWeight="SemiBold"
                      Foreground="#FFFFFFFF"
                      Margin="0,0,0,12"
                      TextWrapping="Wrap"/>
            
            <!-- Content Area with translation overlay -->
            <Grid x:Name="ContentInteractionSurface"
                  Grid.Row="1"
                  Background="Transparent"
                  MouseLeftButtonUp="ContentSurface_MouseLeftButtonUp">
                <Viewbox x:Name="ContentViewbox"
                        Stretch="Uniform">
                    <ContentPresenter x:Name="ContentArea"/>
                </Viewbox>
                
                <!-- Translation Overlay -->
                <Border x:Name="TranslationOverlay"
                       Background="#80000000"
                       Visibility="Collapsed"
                       CornerRadius="8">
                    <Viewbox Stretch="Uniform" Margin="20">
                        <TextBlock x:Name="TranslationText"
                                  Foreground="White"
                                  TextWrapping="Wrap"
                                  TextAlignment="Center"
                                  MaxWidth="800"/>
                    </Viewbox>
                </Border>
            </Grid>
            
            <!-- Translate Button -->
            <Button x:Name="TranslateButton"
                   Grid.Row="2"
                   Content="Translate"
                   Visibility="Collapsed"
                   Margin="0,12,0,0"
                   Padding="20,8"
                   Background="#FF2196F3"
                   Foreground="White"
                   BorderThickness="0"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Cursor="Hand"
                   Click="TranslateButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                           CornerRadius="8"
                                           Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF1976D2"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</Window>
