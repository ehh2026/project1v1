<Window x:Class="InteractiveWorldMap.Views.DidacticTextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Didactic Information" 
        Width="350"
        MaxHeight="800"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    <Border Background="#A61E1E1E"
            CornerRadius="12"
            Padding="16"
            BorderThickness="2"
            BorderBrush="#FFFFFFFF">
        <Border.Effect>
            <DropShadowEffect Color="Black" 
                            Direction="270" 
                            ShadowDepth="6" 
                            BlurRadius="20" 
                            Opacity="0.25"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Title -->
            <TextBlock x:Name="HeadingText"
                      Grid.Row="0"
                      FontSize="18"
                      FontWeight="SemiBold"
                      Foreground="#FFFFFFFF"
                      Margin="0,0,0,12"/>
            
            <!-- Text Content with ScrollViewer for long text -->
            <ScrollViewer Grid.Row="1"
                         MaxHeight="700"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="DidacticTextBlock"
                          TextWrapping="Wrap"
                          FontSize="14"
                          Foreground="#FFFFFFFF"
                          LineHeight="20"
                          Padding="4"/>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
