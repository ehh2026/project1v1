<UserControl x:Class="InteractiveWorldMap.Views.PinExtensionLine"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
    <Grid>
        <!-- Main pin shaft line -->
        <Line x:Name="PinShaftLine"
              Stroke="#FFB0B0B0"
              StrokeThickness="1.5"
              Opacity="0.9">
            <Line.Effect>
                <DropShadowEffect Color="Black" 
                                Direction="270" 
                                ShadowDepth="0.5" 
                                BlurRadius="1" 
                                Opacity="0.3"/>
            </Line.Effect>
        </Line>
        
        <!-- Optional highlight line for metallic effect -->
        <Line x:Name="HighlightLine"
              Stroke="#FFDDDDDD"
              StrokeThickness="0.5"
              Opacity="0.6"/>
    </Grid>
</UserControl>