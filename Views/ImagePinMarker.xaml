<UserControl x:Class="InteractiveWorldMap.Views.ImagePinMarker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             Cursor="Hand">
    
    <Grid x:Name="PinContainer" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="PinTransform" ScaleX="1.0" ScaleY="1.0"/>
        </Grid.RenderTransform>
        
        <!-- Pin image from cropped source -->
        <Image x:Name="PinImage" 
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality">
            <Image.Effect>
                <DropShadowEffect Color="Black" 
                                Direction="315" 
                                ShadowDepth="2" 
                                BlurRadius="3" 
                                Opacity="0.4"/>
            </Image.Effect>
        </Image>
    </Grid>
</UserControl>