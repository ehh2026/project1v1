<UserControl x:Class="InteractiveWorldMap.Views.DeveloperTuningPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="300"
             MaxWidth="360">
    <UserControl.Resources>
        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#444444"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="#EE111111"
            BorderBrush="#AAFFFFFF"
            BorderThickness="1"
            CornerRadius="6"
            Padding="12">
        <ScrollViewer MaxHeight="620"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Runtime Tuning"
                           Foreground="White"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <UniformGrid Columns="2"
                             Margin="0,0,0,8">
                    <CheckBox x:Name="ChkComposite"
                              Content="Composite pins"
                              Foreground="White"
                              Margin="0,2"
                              Click="OnPanelInputChanged"
                              ToolTip="Use assembled shaft/head image parts. Off shows drawn fallback pins."/>
                    <CheckBox x:Name="ChkPrerasterize"
                              Content="Prerasterize"
                              Foreground="White"
                              Margin="0,2"
                              Click="OnPanelInputChanged"
                              ToolTip="Flatten each composite pin into one bitmap after choosing shaft/head parts."/>
                    <CheckBox x:Name="ChkDebugOverlay"
                              Content="Debug overlay"
                              Foreground="White"
                              Margin="0,2"
                              Click="OnPanelInputChanged"
                              ToolTip="Show composite pin anchor and stretch guides for visual debugging."/>
                    <CheckBox x:Name="ChkUseLitShafts"
                              Content="Lit shafts"
                              Foreground="White"
                              Margin="0,2"
                              Click="OnPanelInputChanged"
                              ToolTip="Prefer lit shaft assets when no shaft variant is set."/>
                </UniformGrid>

                <TextBlock Text="Variants"
                           Foreground="#CCCCCC"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="0,4,0,2"/>
                <TextBlock Text="Shaft"
                           Foreground="#AAAAAA"
                           FontSize="10"/>
                <ComboBox x:Name="CmbShaftVariant"
                          Margin="0,1,0,5"
                          IsEditable="False"
                          Background="#222222"
                          Foreground="White"
                          IsEnabled="{Binding IsChecked, ElementName=ChkComposite}"
                          SelectionChanged="OnVariantSelectionChanged"
                          ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}"
                          ToolTip="Select shaft variant folder name under Pins_v2/parts/shaft_variants. (base) uses base/lit shaft assets."/>
                <TextBlock Text="Head"
                           Foreground="#AAAAAA"
                           FontSize="10"/>
                <ComboBox x:Name="CmbHeadVariant"
                          Margin="0,1,0,8"
                          IsEditable="False"
                          Background="#222222"
                          Foreground="White"
                          IsEnabled="{Binding IsChecked, ElementName=ChkComposite}"
                          SelectionChanged="OnVariantSelectionChanged"
                          ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}"
                          ToolTip="Select head variant folder name under Pins_v2/parts/head_variants. (base) uses base head assets."/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="92"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Cluster threshold" Foreground="#DDDDDD" Margin="0,3"/>
                    <TextBox x:Name="TxtClusterThreshold" Grid.Row="0" Grid.Column="1" TextChanged="OnPanelInputChanged"
                             ToolTip="Pixel distance used to group nearby locations into cluster markers."/>

                    <TextBlock Grid.Row="1" Text="Stub length" Foreground="#DDDDDD" Margin="0,3"/>
                    <TextBox x:Name="TxtStubLength" Grid.Row="1" Grid.Column="1" TextChanged="OnPanelInputChanged"
                             ToolTip="Screen-pixel length from map location to pin head for automatic standalone stubs."/>

                    <TextBlock Grid.Row="2" Text="Head radius" Foreground="#DDDDDD" Margin="0,3"/>
                    <TextBox x:Name="TxtTargetHeadRadius" Grid.Row="2" Grid.Column="1" TextChanged="OnPanelInputChanged"
                             ToolTip="Target composite head radius in screen pixels. Zero uses proportional fallback scaling."/>

                    <TextBlock Grid.Row="3" Text="Shaft half width" Foreground="#DDDDDD" Margin="0,3"/>
                    <TextBox x:Name="TxtTargetShaftHalfWidth" Grid.Row="3" Grid.Column="1" TextChanged="OnPanelInputChanged"
                             ToolTip="Target composite shaft half-width in screen pixels. Zero uses proportional shaft scaling."/>

                    <TextBlock Grid.Row="4" Text="Location marker" Foreground="#DDDDDD" Margin="0,3"/>
                    <TextBox x:Name="TxtLocationMarkerSize" Grid.Row="4" Grid.Column="1" TextChanged="OnPanelInputChanged"
                             ToolTip="Nominal individual-marker size used for placement and overlap math."/>

                    <TextBlock Grid.Row="5" Text="Cluster marker" Foreground="#DDDDDD" Margin="0,3"/>
                    <TextBox x:Name="TxtClusterMarkerSize" Grid.Row="5" Grid.Column="1" TextChanged="OnPanelInputChanged"
                             ToolTip="Screen-pixel size of aggregate cluster markers."/>
                </Grid>

                <TextBlock Text="Tip cap (drawn pins)"
                           Foreground="#CCCCCC"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="0,10,0,2"/>
                <TextBlock Text="Style"
                           Foreground="#AAAAAA"
                           FontSize="10"/>
                <ComboBox x:Name="CmbTipCapStyle"
                          Margin="0,1,0,5"
                          IsEditable="False"
                          Background="#222222"
                          Foreground="White"
                          SelectionChanged="OnVariantSelectionChanged"
                          ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}"
                          ToolTip="Cap drawn at the pin tip. None disables it; Horizontal draws a flat bar; Concave draws a shallow arc so the pin reads as stuck into the map.">
                    <ComboBoxItem Content="None"/>
                    <ComboBoxItem Content="Horizontal"/>
                    <ComboBoxItem Content="Concave"/>
                </ComboBox>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="92"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Cap width (+px)" Foreground="#DDDDDD" Margin="0,3"/>
                    <TextBox x:Name="TxtTipCapExtend" Grid.Row="0" Grid.Column="1" TextChanged="OnPanelInputChanged"
                             ToolTip="Extra half-width in screen px added to each side beyond the shaft outline."/>

                    <TextBlock Grid.Row="1" Text="Cap height (px)" Foreground="#DDDDDD" Margin="0,3"/>
                    <TextBox x:Name="TxtTipCapHeight" Grid.Row="1" Grid.Column="1" TextChanged="OnPanelInputChanged"
                             ToolTip="Height in screen px of the Horizontal bar, extending downward from the tip."/>

                    <TextBlock Grid.Row="2" Text="Curvature (px)" Foreground="#DDDDDD" Margin="0,3"/>
                    <TextBox x:Name="TxtTipCapArcDepth" Grid.Row="2" Grid.Column="1" TextChanged="OnPanelInputChanged"
                             ToolTip="Concave arc depth in screen px. Larger values bow the arc more toward the head."/>
                </Grid>

                <TextBlock x:Name="StatusText"
                           Foreground="#FFFFCC66"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Margin="0,8,0,0"/>
                <TextBlock x:Name="ErrorText"
                           Foreground="#FFFF8080"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Margin="0,4,0,0"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,10,0,0">
                    <Button Content="Reload"
                            Padding="10,5"
                            Margin="0,0,6,0"
                            Click="OnReloadClick"
                            ToolTip="Reload visual-config.json and apply supported tuning values at runtime."/>
                    <Button Content="Save"
                            Padding="10,5"
                            Margin="0,0,6,0"
                            Click="OnSaveClick"
                            ToolTip="Save the current runtime tuning values back to visual-config.json."/>
                    <Button x:Name="ApplyButton"
                            Content="Apply"
                            Padding="10,5"
                            Click="OnApplyClick"
                            ToolTip="Apply the current panel values without restarting the app."/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
