<UserControl x:Class="InteractiveWorldMap.Views.LocationMarker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Cursor="Hand">
    <UserControl.Resources>
        <Style TargetType="Ellipse" x:Key="MarkerStyle">
            <Setter Property="Fill">
                <Setter.Value>
                    <RadialGradientBrush>
                        <GradientStop Color="White" Offset="0.0"/>
                        <GradientStop Color="#FFE53935" Offset="1.0"/>
                    </RadialGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Stroke" Value="#FFC62828"/>
            <Setter Property="StrokeThickness" Value="1"/>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Ellipse x:Name="MarkerEllipse" 
                 Style="{StaticResource MarkerStyle}"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="MarkerScale" ScaleX="1.0" ScaleY="1.0"/>
            </Ellipse.RenderTransform>
        </Ellipse>
    </Grid>
</UserControl>
