<UserControl x:Class="InteractiveWorldMap.Views.PinMarker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             Cursor="Hand">
    <UserControl.Resources>
        <Style TargetType="Ellipse" x:Key="PinBallStyle">
            <Setter Property="Fill">
                <Setter.Value>
                    <RadialGradientBrush>
                        <GradientStop Color="White" Offset="0.2"/>
                        <GradientStop Color="{Binding PinColor, RelativeSource={RelativeSource AncestorType=UserControl}}" Offset="1.0"/>
                    </RadialGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Stroke" Value="#FF333333"/>
            <Setter Property="StrokeThickness" Value="0.5"/>
        </Style>
        
        <Style TargetType="Rectangle" x:Key="PinShaftStyle">
            <Setter Property="Fill" Value="#FFB0B0B0"/>
            <Setter Property="Stroke" Value="#FF808080"/>
            <Setter Property="StrokeThickness" Value="0.3"/>
        </Style>
    </UserControl.Resources>
    
    <Grid x:Name="PinContainer" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="PinTransform" ScaleX="1.0" ScaleY="1.0"/>
        </Grid.RenderTransform>
        
        <!-- Pin shaft (thin metal part) -->
        <Rectangle x:Name="PinShaft" 
                   Style="{StaticResource PinShaftStyle}"
                   Width="1.5"
                   Height="20"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Center"
                   Margin="0,8,0,0"/>
        
        <!-- Pin ball (colored sphere at the end) -->
        <Ellipse x:Name="PinBall" 
                 Style="{StaticResource PinBallStyle}"
                 Width="8"
                 Height="8"
                 VerticalAlignment="Top"
                 HorizontalAlignment="Center">
            <Ellipse.Effect>
                <DropShadowEffect Color="Black" 
                                Direction="315" 
                                ShadowDepth="1" 
                                BlurRadius="2" 
                                Opacity="0.4"/>
            </Ellipse.Effect>
        </Ellipse>
    </Grid>
</UserControl>