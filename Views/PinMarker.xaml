<UserControl x:Class="InteractiveWorldMap.Views.PinMarker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="False"
             UseLayoutRounding="False"
             Cursor="Hand">
    <Grid x:Name="PinContainer" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="PinTransform" ScaleX="1.0" ScaleY="1.0"/>
        </Grid.RenderTransform>

        <!-- Shaft: dark outline rect behind lighter core (same approach as composite outline_dark) -->
        <Grid x:Name="ShaftHost"
              VerticalAlignment="Top"
              HorizontalAlignment="Center">
            <Rectangle x:Name="PinShaftOutline"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Center"/>
            <Rectangle x:Name="PinShaft"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Center"/>
        </Grid>

        <!-- Pin ball with black rim applied in code from PinMarkerConfig -->
        <Ellipse x:Name="PinBall"
                 VerticalAlignment="Top"
                 HorizontalAlignment="Center">
            <Ellipse.Effect>
                <DropShadowEffect Color="Black"
                                  Direction="315"
                                  ShadowDepth="1.5"
                                  BlurRadius="2.5"
                                  Opacity="0.55"/>
            </Ellipse.Effect>
        </Ellipse>
    </Grid>
</UserControl>
