<Window x:Class="InteractiveWorldMap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:InteractiveWorldMap.Views"
        Title="Interactive World Map" 
        WindowState="Maximized"
        WindowStyle="None"
        Background="Black">
    <Grid x:Name="RootGrid" RenderOptions.BitmapScalingMode="HighQuality">
        <!-- Map Display with integrated markers -->
        <views:MapDisplayControl x:Name="MapDisplay" 
                                RenderOptions.CachingHint="Cache"
                                CacheMode="BitmapCache"
                                MouseLeftButtonDown="OnMapMouseLeftButtonDown"
                                MouseMove="OnMapMouseMove" />
        
        <!-- Back Button -->
        <Button x:Name="BackButton"
                Content="← Back to Map"
                Visibility="Collapsed"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20"
                Padding="15,8"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="White"
                Background="#CC000000"
                BorderBrush="White"
                BorderThickness="2"
                Cursor="Hand"
                Click="OnBackButtonClick">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#DD000000"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- Edit Layout Button (shown when zoomed and edit mode enabled in config) -->
        <Button x:Name="EditLayoutButton"
                Content="Edit Layout"
                Visibility="Collapsed"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="20"
                Padding="15,8"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="White"
                Background="#CC1E90FF"
                BorderBrush="White"
                BorderThickness="2"
                Cursor="Hand"
                Click="OnEditLayoutButtonClick">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#DD1E90FF"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- Unsaved overrides indicator (shown in non-edit mode when pending shaft overrides exist) -->
        <TextBlock x:Name="OverridePendingIndicator"
                   Text="* unsaved overrides"
                   Visibility="Collapsed"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="0,58,20,0"
                   Foreground="#FFFFA500"
                   FontSize="11"
                   FontStyle="Italic"
                   Padding="6,3"/>

        <!-- Edit Mode Control Panel (shown only in edit mode) -->
        <StackPanel x:Name="EditModePanel"
                    Visibility="Collapsed"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="20,70,20,0"
                    Background="#DD000000"
                    Orientation="Vertical">
            
            <!-- Status Indicator -->
            <TextBlock x:Name="EditModeStatusText"
                       Text="EDIT MODE ACTIVE"
                       Foreground="#FFD700"
                       FontSize="12"
                       FontWeight="Bold"
                       Padding="10,8"
                       TextAlignment="Center"/>
            
            <!-- Variant Picker -->
            <TextBlock Text="Variants:"
                       Foreground="#BBBBBB"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Padding="10,6,10,2"/>
            <ComboBox x:Name="VariantPickerComboBox"
                      Margin="5,0,5,0"
                      FontSize="12"
                      MinWidth="160">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}"/>
                            <TextBlock Text=" [" Foreground="#999"/>
                            <TextBlock Text="{Binding Origin}" Foreground="#999"/>
                            <TextBlock Text="]" Foreground="#999"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock x:Name="VariantStatusText"
                       Text=""
                       Foreground="#AAAAAA"
                       FontSize="10"
                       Padding="10,2"
                       TextAlignment="Center"/>

            <!-- Inline Save-As input row (shown on Save As click) -->
            <Grid x:Name="SaveAsInputRow" Visibility="Collapsed" Margin="5,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SaveAsNameTextBox"
                         Grid.Column="0"
                         FontSize="12"
                         Padding="4,3"
                         KeyDown="OnSaveAsNameKeyDown"/>
                <Button x:Name="SaveAsOkButton"
                        Grid.Column="1"
                        Content="OK"
                        Padding="8,4"
                        Margin="2,0"
                        FontSize="11"
                        Foreground="White"
                        Background="#CC228B22"
                        BorderBrush="White"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="OnSaveAsConfirmButtonClick"/>
                <Button x:Name="SaveAsCancelButton"
                        Grid.Column="2"
                        Content="&#x2715;"
                        Padding="8,4"
                        FontSize="11"
                        Foreground="White"
                        Background="#CC696969"
                        BorderBrush="White"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="OnSaveAsCancelButtonClick"/>
            </Grid>

            <!-- Save As Variant Button -->
            <Button x:Name="SaveAsVariantButton"
                    Content="Save As..."
                    Padding="15,8"
                    Margin="5,2,5,0"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Background="#CC4169E1"
                    BorderBrush="White"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="OnSaveAsVariantButtonClick"/>

            <!-- Delete Variant Button (Manual only; service enforces guard) -->
            <Button x:Name="DeleteVariantButton"
                    Content="Delete Variant"
                    Padding="15,8"
                    Margin="5,2,5,5"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Background="#CCDC143C"
                    BorderBrush="White"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="OnDeleteVariantButtonClick"/>

            <!-- Save Layout Button -->
            <Button x:Name="SaveLayoutButton"
                    Content="Save Layout"
                    Padding="15,8"
                    Margin="5"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Background="#CC228B22"
                    BorderBrush="White"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="OnSaveLayoutButtonClick">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DD32CD32"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Delete & Recalculate Button -->
            <Button x:Name="DeleteLayoutButton"
                    Content="Delete and Recalculate"
                    Padding="15,8"
                    Margin="5"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Background="#CCDC143C"
                    BorderBrush="White"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="OnDeleteLayoutButtonClick">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DDFF1493"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Auto Assign Pins Button -->
            <Button x:Name="ReassignPinsButton"
                    Content="Auto Assign Pins"
                    Padding="15,8"
                    Margin="5"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Background="#CC8B4513"
                    BorderBrush="White"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="OnReassignPinsButtonClick">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DDA0522D"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Exit Edit Mode Button -->
            <Button x:Name="ExitEditModeButton"
                    Content="Exit Edit Mode"
                    Padding="15,8"
                    Margin="5"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Background="#CC696969"
                    BorderBrush="White"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="OnExitEditModeButtonClick">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DD808080"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <!-- Manual Layout Active Indicator (shown when manual layout is loaded) -->
        <Border x:Name="ManualLayoutIndicator"
                Visibility="Collapsed"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="20"
                Background="#CC4169E1"
                BorderBrush="White"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,5">
            <TextBlock Text="Manual Layout Active"
                       Foreground="White"
                       FontSize="11"
                       FontWeight="SemiBold"/>
        </Border>

        <views:DeveloperTuningPanel x:Name="DeveloperTuningPanel"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Margin="20,20,20,60"
                                    ApplyRequested="OnApplyTuning"
                                    SaveRequested="OnSaveTuningToDisk"
                                    ReloadRequested="OnReloadTuningFromDisk"/>

        <Button x:Name="TuningPanelToggleBtn"
                Content="Tuning"
                Visibility="Collapsed"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="20"
                Padding="15,8"
                Background="#CC555555"
                Foreground="White"
                Click="OnTuningPanelToggleClick"/>
    </Grid>
</Window>
