<Window x:Class="InteractiveWorldMap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:InteractiveWorldMap.Views"
        Title="Interactive World Map" 
        WindowState="Maximized"
        WindowStyle="None"
        Background="Black">
    <Grid x:Name="RootGrid" RenderOptions.BitmapScalingMode="HighQuality">
        <!-- Map Display with integrated markers -->
        <!-- No CacheMode="BitmapCache" here: it rasterized the whole control (map + vector pin
             markers/shafts) into a bitmap that gets resampled, softening and darkening the crisp
             vector shafts/heads when zoomed (measured shaft core ~176 vs ~216 unzoomed). The zoom
             animation already uses its own pre-rendered keyframe bitmaps, so the live cache is not
             needed for smoothness. -->
        <views:MapDisplayControl x:Name="MapDisplay"
                                MouseLeftButtonDown="OnMapMouseLeftButtonDown"
                                MouseMove="OnMapMouseMove" />
        
        <!-- Bottom-left navigation and developer status -->
        <StackPanel HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="20">
            <Border x:Name="ManualLayoutIndicator"
                    Visibility="Collapsed"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Left"
                    Background="#CC4169E1"
                    BorderBrush="White"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,5">
                <TextBlock Text="Manual Layout Active"
                           Foreground="White"
                           FontSize="11"
                           FontWeight="SemiBold"/>
            </Border>

            <!-- Transient content status/warning banner (e.g. loading or large-image notice) -->
            <Border x:Name="ContentStatusBanner"
                    Visibility="Collapsed"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Left"
                    Background="#CC000000"
                    BorderBrush="#FFD700"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,5">
                <TextBlock x:Name="ContentStatusText"
                           Text=""
                           Foreground="White"
                           FontSize="11"
                           FontWeight="SemiBold"/>
            </Border>

            <Button x:Name="BackButton"
                    Content="← Back to Full Map"
                    Visibility="Collapsed"
                    HorizontalAlignment="Left"
                    Padding="15,8"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Background="#CC000000"
                    BorderBrush="White"
                    BorderThickness="2"
                    Cursor="Hand"
                    Click="OnBackButtonClick">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DD000000"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <!-- Edit Layout Button (shown when zoomed and edit mode enabled in config) -->
        <Button x:Name="EditLayoutButton"
                Content="Edit Layout"
                Visibility="Collapsed"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="20"
                Padding="15,8"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="White"
                Background="#CC1E90FF"
                BorderBrush="White"
                BorderThickness="2"
                Cursor="Hand"
                Click="OnEditLayoutButtonClick">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#DD1E90FF"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- Unsaved overrides indicator (shown in non-edit mode when pending shaft overrides exist) -->
        <TextBlock x:Name="OverridePendingIndicator"
                   Text="* unsaved overrides"
                   Visibility="Collapsed"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="0,58,20,0"
                   Foreground="#FFFFA500"
                   FontSize="11"
                   FontStyle="Italic"
                   Padding="6,3"/>

        <!-- Edit Mode Control Panel (shown only in edit mode) -->
        <StackPanel x:Name="EditModePanel"
                    Visibility="Collapsed"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="20,70,20,0"
                    Background="#DD000000"
                    Orientation="Vertical">
            
            <!-- Status Indicator -->
            <TextBlock x:Name="EditModeStatusText"
                       Text="EDIT MODE ACTIVE"
                       Foreground="#FFD700"
                       FontSize="12"
                       FontWeight="Bold"
                       Padding="10,8"
                       TextAlignment="Center"/>
            
            <!-- What this session is editing. Layouts are per view; without this the panel looks
                 identical for the whole map and for every cluster, so there is no way to tell what
                 a save is about to write to. Set from LayoutEditSession.ScopeDescription, which is
                 derived from the session that actually performs the save. -->
            <TextBlock x:Name="EditScopeText"
                       Text=""
                       Foreground="#FFFFFF"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Padding="10,0,10,8"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="220"/>

            <!-- Variant Picker. Labelled "for this view" so an empty list reads as a fact about
                 the current view rather than as missing work. -->
            <TextBlock Text="Saved layouts for this view:"
                       Foreground="#BBBBBB"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Padding="10,6,10,2"/>
            <ComboBox x:Name="VariantPickerComboBox"
                      Margin="5,0,5,0"
                      FontSize="12"
                      MinWidth="160">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}"/>
                            <TextBlock Text=" [" Foreground="#999"/>
                            <TextBlock Text="{Binding Origin}" Foreground="#999"/>
                            <TextBlock Text="]" Foreground="#999"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock x:Name="VariantStatusText"
                       Text=""
                       Foreground="#AAAAAA"
                       FontSize="10"
                       Padding="10,2"
                       TextAlignment="Center"/>

            <!-- Save Layout Button -->
            <Button x:Name="SaveLayoutButton"
                    Content="Save Layout"
                    Padding="15,8"
                    Margin="5"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Background="#CC228B22"
                    BorderBrush="White"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="OnSaveLayoutButtonClick">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DD32CD32"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Inline Save-As input row (shown on Save As click) -->
            <Grid x:Name="SaveAsInputRow" Visibility="Collapsed" Margin="5,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SaveAsNameTextBox"
                         Grid.Column="0"
                         FontSize="12"
                         Padding="4,3"
                         KeyDown="OnSaveAsNameKeyDown"/>
                <Button x:Name="SaveAsOkButton"
                        Grid.Column="1"
                        Content="OK"
                        Padding="8,4"
                        Margin="2,0"
                        FontSize="11"
                        Foreground="White"
                        Background="#CC228B22"
                        BorderBrush="White"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="OnSaveAsConfirmButtonClick"/>
                <Button x:Name="SaveAsCancelButton"
                        Grid.Column="2"
                        Content="&#x2715;"
                        Padding="8,4"
                        FontSize="11"
                        Foreground="White"
                        Background="#CC696969"
                        BorderBrush="White"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="OnSaveAsCancelButtonClick"/>
            </Grid>

            <!-- Save As Variant Button -->
            <Button x:Name="SaveAsVariantButton"
                    Content="Save As..."
                    Padding="15,8"
                    Margin="5,2,5,0"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Background="#CC4169E1"
                    BorderBrush="White"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="OnSaveAsVariantButtonClick"/>

            <!-- Separator: everything above adds or updates a layout; everything below stops one
                 being used. Phase 2 made the labels honest about what each destroys; the grouping
                 is so the two are not read as one list of five similar buttons. -->
            <Border Height="1" Background="#55FFFFFF" Margin="10,10,10,2"/>
            <TextBlock Text="Stop using this layout"
                       Foreground="#BBBBBB"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Padding="10,2,10,4"
                       TextAlignment="Center"/>

            <!-- Unload Layout Button (non-destructive: reverts to auto-placement, keeps file on disk) -->
            <Button x:Name="UnloadLayoutButton"
                    Content="Unload and Recalculate"
                    Padding="15,10"
                    Margin="5"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="White"
                    Background="#CCDAA520"
                    BorderBrush="White"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="OnUnloadLayoutButtonClick">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DDFFC125"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Delete Variant Button (Manual only; service enforces guard).
                 Deletes only the variant on screen - see DeleteLayoutButton for the bulk action. -->
            <Button x:Name="DeleteVariantButton"
                    Content="Delete This Layout"
                    Padding="15,8"
                    Margin="5,2,5,5"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Background="#CCDC143C"
                    BorderBrush="White"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="OnDeleteVariantButtonClick"/>

            <!-- Bulk delete: destroys every hand-made layout for this view. Confirmed in the
                 handler, which names them and states the count. -->
            <Button x:Name="DeleteLayoutButton"
                    Content="Delete ALL Saved Layouts"
                    Padding="15,8"
                    Margin="5"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Background="#CCDC143C"
                    BorderBrush="White"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="OnDeleteLayoutButtonClick">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DDFF1493"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Auto Assign Pins Button. Composite-only: it picks image shaft/head pairs to fit
                 each pin. With drawn pins there is nothing to pick, so it is disabled rather than
                 hidden - a button that vanishes reads as a broken feature, and the tooltip can
                 then say what would bring it back. ShowOnDisabled so that tooltip survives being
                 disabled, which WPF otherwise suppresses. -->
            <Button x:Name="ReassignPinsButton"
                    Content="Auto Assign Pins"
                    Padding="15,8"
                    Margin="5"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Background="#CC8B4513"
                    BorderBrush="White"
                    BorderThickness="1"
                    ToolTipService.ShowOnDisabled="True"
                    Click="OnReassignPinsButtonClick">
                <Button.Style>
                    <Style TargetType="Button">
                        <!-- Cursor lives here rather than on the button: a value set directly on
                             the element wins over any style setter, so a disabled button would
                             keep the hand cursor and go on inviting the click. -->
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DDA0522D"/>
                            </Trigger>
                            <!-- The custom template above replaces the default chrome, and with it
                                 the greying WPF would normally apply. Without these the button
                                 looks identical enabled and disabled. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#66503010"/>
                                <Setter Property="Foreground" Value="#88FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#55FFFFFF"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Exit Edit Mode Button -->
            <Button x:Name="ExitEditModeButton"
                    Content="Exit Edit Mode"
                    Padding="15,8"
                    Margin="5"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Background="#CC696969"
                    BorderBrush="White"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="OnExitEditModeButtonClick">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DD808080"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <views:DeveloperTuningPanel x:Name="DeveloperTuningPanel"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Margin="20,20,20,60"
                                    ApplyRequested="OnApplyTuning"
                                    SaveRequested="OnSaveTuningToDisk"
                                    ReloadRequested="OnReloadTuningFromDisk"
                                    CloseRequested="OnTuningPanelCloseRequested"/>

        <Button x:Name="TuningPanelToggleBtn"
                Content="Tuning"
                Visibility="Collapsed"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="20"
                Padding="15,8"
                Background="#CC555555"
                Foreground="White"
                Click="OnTuningPanelToggleClick">
            <Button.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Map" Tag="Map" Click="OnTuningCategoryClick"/>
                    <MenuItem Header="Composite Pins" Tag="CompositePins" Click="OnTuningCategoryClick"/>
                    <MenuItem Header="Drawn Pins" Tag="DrawnPins" Click="OnTuningCategoryClick"/>
                    <MenuItem Header="Hitboxes" Tag="Hitboxes" Click="OnTuningCategoryClick"/>
                    <MenuItem Header="Shadows" Tag="Shadows" Click="OnTuningCategoryClick"/>
                    <MenuItem Header="Content Windows" Tag="ContentWindows" Click="OnTuningCategoryClick"/>
                </ContextMenu>
            </Button.ContextMenu>
        </Button>
    </Grid>
</Window>
