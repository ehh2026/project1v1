<Window x:Class="InteractiveWorldMap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:InteractiveWorldMap.Views"
        Title="Interactive World Map" 
        WindowState="Maximized"
        WindowStyle="None"
        Background="Black">
    <Grid x:Name="RootGrid">
        <!-- Map Display Layer -->
        <views:MapDisplayControl x:Name="MapDisplay" />
        
        <!-- Marker Layer (overlay) -->
        <views:MarkerLayerControl x:Name="MarkerLayer" />
    </Grid>
</Window>
