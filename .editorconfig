root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
end_of_line = crlf

[*.{json,md,yml,yaml}]
indent_style = space
indent_size = 2

[*.{ps1,sh}]
indent_style = space
indent_size = 4

[*.py]
indent_style = space
indent_size = 4
